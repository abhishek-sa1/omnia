{#- Additional cloud-init write_files injection partial -#}
{#- Requires: _aci_phase ('pre' or 'post'), functional_group_name -#}
{#- Pre phase: common + pre per-FG. Post phase: post per-FG only. -#}
{#- Use inside an existing write_files: section in a FG template -#}
{%- if additional_cloud_init_enabled | default(false) | bool -%}
{%- if _aci_phase == 'pre' -%}
{%- set _aci_c_data = additional_cloud_init_common_data | default({}) -%}
{%- set _aci_g_all = additional_cloud_init_pre_groups_data | default({}) -%}
{%- else -%}
{%- set _aci_c_data = {} -%}
{%- set _aci_g_all = additional_cloud_init_post_groups_data | default({}) -%}
{%- endif -%}
{%- set _aci_g_data = _aci_g_all[functional_group_name] if functional_group_name in _aci_g_all else {} -%}
{%- set _aci_wf = (_aci_c_data.write_files | default([])) + (_aci_g_data.write_files | default([])) -%}
{% for wf in _aci_wf %}
        - path: {{ wf.path }}
{% if wf.permissions is defined %}
          permissions: '{{ wf.permissions }}'
{% endif %}
{% if wf.owner is defined %}
          owner: {{ wf.owner }}
{% endif %}
{% if wf.append is defined %}
          append: {{ wf.append | lower }}
{% endif %}
{% if wf.encoding is defined %}
          encoding: {{ wf.encoding }}
{% endif %}
          content: |
            {{ wf.content | indent(12) }}
{% endfor %}
{%- endif -%}
