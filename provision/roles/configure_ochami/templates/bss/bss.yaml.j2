---
{% if s3_configurations.provider | default('powerscale') == 'powerscale' %}
{% set s3_base_url = s3_configurations.endpoint_url %}
{% else %}
{% set s3_base_url = "http://" + cluster_boot_ip + ":9000" %}
{% endif %}
kernel: "{{ s3_base_url }}/{{ kernel }}"
initrd: "{{ s3_base_url }}/{{ initrd }}"
{% set bs_suffix = compute_image_suffix
   if enable_build_stream | default(false)
   and (compute_image_suffix | default('')) != ''
   else "" %}
{% set img_suffix = naming_suffix | default('') %}
{% set root_image_path =
  "boot-images/%s/rhel-%s%s%s/rhel%s-rhel-%s%s%s-%s" % (
    functional_group_name,
    functional_group_name,
    img_suffix,
    bs_suffix,
    hostvars['localhost']['cluster_os_version'],
    functional_group_name,
    img_suffix,
    bs_suffix,
    hostvars['localhost']['cluster_os_version']
  )
%}
{% set additional_common_params = '' %}
{% if additional_bss_params_common_enabled | default(false) | bool and additional_bss_params_common_data.params is defined %}
{% set additional_common_params = additional_bss_params_common_data.params | join(' ') %}
{% endif %}
{% set additional_fg_params = '' %}
{% if additional_bss_params_groups_enabled | default(false) | bool and additional_bss_params_groups_data[functional_group_name] is defined and additional_bss_params_groups_data[functional_group_name].params is defined %}
{% set additional_fg_params = additional_bss_params_groups_data[functional_group_name].params | join(' ') %}
{% endif %}
params: "nomodeset ro root=live:{{ s3_base_url }}/{{ root_image_path }} ip=dhcp rd.live.image rd.live.ram rd.neednet=1 {% if s3_configurations.provider | default('powerscale') == 'powerscale' %}rd.noverifyssl {% endif %}rd.driver.blacklist=ccp,edac_core,power_meter,ahci,megaraid_sas modprobe.blacklist=ccp,edac_core,power_meter,ahci,megaraid_sas libata.force=1:disable,2:disable,3:disable,4:disable rd.luks=0 rd.md=0 rd.dm=0 console=tty0 console=ttyS0,115200 selinux=0 apparmor=0 ip6=off {{ bss_params_cloud_init }}{% if additional_common_params %} {{ additional_common_params }}{% endif %}{% if additional_fg_params %} {{ additional_fg_params }}{% endif %}"
macs:
{% for item in nodes %}
{% if item.group == functional_group_name %}
  - {{ item.interfaces[0].mac_addr }}
{% endif %}
{% endfor %}
